PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=reportes_db
DB_USER=postgres
DB_PASSWORD=tu_clave_aqui

JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta

# Umbrales para el monitoreo de recursos (porcentaje 0-100)
UMBRAL_CPU=85
UMBRAL_RAM=85

# Minutos de vida de un enlace firmado de descarga
MINUTOS_LINK=10

# Horas que se conservan los reportes antes de ser borrados (garbage collection)
HORAS_RETENCION=24
# (Opcional, para demos) Si lo activas, tiene prioridad sobre HORAS_RETENCION:
# MINUTOS_RETENCION=1

# Reintentos automáticos: veces que el worker intenta un reporte antes de marcarlo como fallido
MAX_INTENTOS=3

# (Opcional, para demos) Retraso en ms por cada lote de 250 filas, para ver la barra de progreso
# RETARDO_LOTE_MS=300

# Límite de peticiones por IP para crear reportes (rate limiting)
RATE_LIMIT_MAX=20
RATE_LIMIT_VENTANA_SEG=60

# (Opcional) Nombre del worker. También puede pasarse así: npm run worker -- 2
# WORKER_ID=1

# Horas que dura la sesión (token de login)
HORAS_SESION=8

# Límite de intentos de login/registro por IP en la ventana (frena el adivinar claves)
RATE_LIMIT_AUTH_MAX=10
